{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://Serponado.com/schema/entity.schema.json",
  "title": "Serponado Entity",
  "description": "JSON Schema for validating Serponado entity page frontmatter",
  "type": "object",
  "required": ["entityId", "name", "type", "version", "status", "namespace", "attributes", "evidence", "lastReviewed"],
  "properties": {
    "entityId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique kebab-case entity identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display name"
    },
    "type": {
      "type": "string",
      "enum": [
        "SERP_Feature",
        "Paid_Feature",
        "Ranking_Factor",
        "Algorithm",
        "Algorithm_Update",
        "Search_Intent",
        "Metric",
        "Technical_Attribute",
        "AI_Search_Feature",
        "Layout_Element",
        "Entity_Type",
        "Tool",
        "Concept"
      ],
      "description": "Entity type classification"
    },
    "schemaType": {
      "type": "string",
      "description": "Most relevant Schema.org type"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of this entity record"
    },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated", "emerging", "experimental", "historical"],
      "description": "Lifecycle status of the entity"
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Alternative names and former names"
    },
    "sameAs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "description": "External knowledge base URIs"
    },
    "parent": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Parent entity ID"
    },
    "namespace": {
      "type": "string",
      "enum": [
        "serp-features",
        "paid-features",
        "ranking-factors",
        "algorithms",
        "intent",
        "metrics",
        "technical",
        "ai-search",
        "layout",
        "knowledge-entities"
      ],
      "description": "Subdirectory namespace within entities/"
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["predicate", "target"],
        "properties": {
          "predicate": {
            "type": "string",
            "enum": [
              "IS_TYPE_OF",
              "HAS_SUBTYPE",
              "PART_OF",
              "CONTAINS",
              "TRIGGERS",
              "TRIGGERED_BY",
              "COMPETES_WITH",
              "REQUIRES",
              "POWERS",
              "POWERED_BY",
              "REPLACED_BY",
              "REPLACES",
              "MEASURES",
              "MEASURED_BY",
              "OPTIMIZED_BY",
              "AFFECTS",
              "INTRODUCED_BY",
              "DEPRECATED_BY",
              "RELATED_TO",
              "ANALOGOUS_TO"
            ]
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "attributes": {
      "type": "object",
      "description": "Entity-specific key-value attributes"
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["source", "title", "retrieved"],
        "properties": {
          "source": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "retrieved": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "relevanceScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "quote": {
            "type": "string",
            "maxLength": 200
          }
        },
        "additionalProperties": false
      },
      "description": "Source citations supporting entity claims"
    },
    "lastReviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date of last content review"
    }
  },
  "additionalProperties": false
}
